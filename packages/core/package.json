{
  "name": "egy-pay",
  "version": "0.1.1",
  "description": "Headless payment workflow domain and application services for egy-pay.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahim8ismael/egy-pay.git",
    "directory": "packages/core"
  },
  "homepage": "https://egy-pay.vercel.app/docs",
  "bugs": {
    "url": "https://github.com/ibrahim8ismael/egy-pay/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "egypt",
    "payments",
    "payment-workflow",
    "typescript"
  ]
}
